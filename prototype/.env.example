DATABASE_PATH=./data/prototype.sqlite3
# Coordinator logs: json (one object per line) or text, and debug|info|warning|error.
# Logs never contain keys, tokens, codes, prompts or answers.
LOG_FORMAT=json
LOG_LEVEL=info
# Coordinator's Ed25519 private key for signing jobs. Created on first start (owner-only).
# Default: coordinator-signing.key next to the database. Never commit or share it.
# (PROTOTYPE_SECRET is no longer used.)
# COORDINATOR_SIGNING_KEY_FILE=./data/coordinator-signing.key
# Optional (`handover-key-v1`): PUBLIC half of an offline key that must also sign every key
# handover. Make it with `python -m app.key_rotation make-handover-key --out /media/usb/...`
# and keep the private file offline. Leave empty for off.
# COORDINATOR_HANDOVER_PUBLIC_KEY=
# Seconds a worker holds a job before it is requeued (5-3600)
LEASE_SECONDS=60
# Claims allowed per job before it is marked failed/rejected (1-20)
MAX_ATTEMPTS=3
# Share of unproven (schema-only) results re-run by another worker, 0.0-1.0
AUDIT_RATE=0.25
# Trust tiers (audit-tier-v1): rigs with fewer than AUDIT_NEW_UNTIL independently checked
# results are re-checked at AUDIT_RATE_NEW; rigs with a strike (failed hidden test or
# outvoted) at AUDIT_RATE_SUSPECT. Never below AUDIT_RATE. AUDIT_NEW_UNTIL=0 turns "new" off.
AUDIT_RATE_NEW=0.5
AUDIT_RATE_SUSPECT=1.0
AUDIT_NEW_UNTIL=5
# When a re-run disagrees, send the job to a third worker to break the tie (true/false)
TIEBREAK=true
# Audits and tie-breakers go to a random active worker, not whoever asks first.
# A worker counts as active this many seconds after its last request (10-86400)
AUDITOR_ACTIVE_SECONDS=300
# Who may be picked to audit or break a tie (auditor-pick-v1):
#   uniform        any eligible rig, same chance, including a rig with a strike (default)
#   trusted-first  established rigs first, then new ones; a rig with a strike only when
#                  nobody else is eligible. Audit work pays points, so this shifts who earns them.
AUDITOR_PICK=uniform
# Who may settle a dispute without a person (tiebreak-trust-v1, threat model #6):
#   always            the tie-breaker's majority settles it (default)
#   established-only  only when the tie-breaker and the rig it agreed with are both
#                     established; otherwise all three stay held for the review queue
TIEBREAK_DECIDES=always
# Scoring rule for simulated reward reports (threat model #15; owner decision):
#   sim-points-v1          unverified work is always paid (default)
#   sim-points-v2-forfeit  a rig with a strike in a period (failed hidden test or
#                          outvoted) loses its unverified points for that period;
#                          points from checked work (confirmed) are kept
REWARD_SCORING=sim-points-v1
# Public ledger delay (public-delay-v1, threat model #14): for this many seconds after a
# result is accepted, GET /v1/ledger counts it as "pending" and hides its confidence,
# whatever kind of job it was. Shown live, a hidden test lands straight in confirmed or
# held while normal AI work lands in pending/unverified, so a rig could spot its tests.
# Keep it longer than an audit plus tie-breaker take. 0 = live (operator health warns).
# The operator token (X-Operator-Token) always sees the live view. 0-2592000
PUBLIC_SETTLE_DELAY_SECONDS=3600
# Public job counts (public-counts-v1, threat model #14): /health and GET /v1/ledger show
# job counts (queued, leased, ...) taken once per clock-aligned window of this many seconds
# and repeated until the next window, for everyone. Shown live, `queued` went up by one
# the instant a rig's result was picked for a re-check. 0 = live (operator health warns).
# The operator token always sees live counts. 0-86400
PUBLIC_COUNTS_INTERVAL_SECONDS=900
# Re-check release (recheck-release-v1, threat model #5): a new audit or tie-breaker is held
# for a random whole number of seconds between these two before anyone can see or take it,
# then released with its own creation time and a deadline counted (and signed) from then.
# Without it, a re-check was made in the very second the result it re-checks was accepted,
# which any rig could see. RECHECK_DELAY_MAX_SECONDS=0 turns it off. 0-86400 each.
RECHECK_DELAY_MIN_SECONDS=60
RECHECK_DELAY_MAX_SECONDS=600
# How often the coordinator's release timer looks for re-checks that are due (1-60 s).
RECHECK_RELEASE_TICK_SECONDS=1
# Seconds the chosen worker has to pick up its audit before it is re-assigned (5-86400)
AUDIT_ASSIGN_SECONDS=120
# Operator health warns about a worker that has dropped this many assigned audits or
# tie-breakers (not picked up in time, lease ran out, or result refused). 1-100000
AUDIT_DROP_WARN=3
# Unlocks operator endpoints (/v1/jobs, /v1/enrollments, /v1/challenges, /v1/audits,
# /v1/workers/{id}/trust, /v1/workers/{id}/revoke). Without it, make worker enrollment
# codes from the database instead: python -m app.workers enroll --owner <label>
# Leave unset to disable them. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value.
# OPERATOR_TOKEN=
# Lets a program queue normal jobs (POST /v1/jobs, header X-Submitter-Token) without
# the operator token: it can't see hidden tests, answers or reports. At least 24
# characters and different from OPERATOR_TOKEN. With neither token set, nobody can
# queue jobs. Never commit the real value.
# SUBMITTER_TOKEN=
# Fixed simulated points per task type (app/points.py, `points-table-v1`). Must list
# every task type, each 0-1000. When set, every new job and hidden test gets these points
# and asking for any other number is refused, so a submitter can't pick a big number for
# a friend's rig. Leave empty to let whoever queues a job pick its points (0-1000).
# Changing it needs a restart; jobs already queued keep their points.
# POINTS_TABLE=demo:sha256=1,llm:generate=10
# Largest request body accepted, in bytes (`input-limits-v1`, 16384 to 4194304). Bigger
# bodies get 413 before they are read; the largest honest request is about 150 KB.
MAX_BODY_BYTES=262144
# `ledger-clock-v1`: refuse to start when the server clock is more than this many seconds
# behind the newest time already in the ledger (a clock reset to 1970/2000, or set back).
# Within it, the coordinator holds its time until the clock catches up (0 to 604800).
CLOCK_BEHIND_LIMIT_SECONDS=300
# A server clock that moves this many seconds more or less than a steady clock between two
# readings counts as a step: logged and shown on the operator health page (1 to 86400).
CLOCK_STEP_WARN_SECONDS=60
# `storage-full-v1`: under this many MB free on the ledger's disk, new jobs, hidden tests
# and enrollment codes are refused (503) so the room left goes to results; claims and
# results carry on. 0 = never refuse.
DISK_RESERVE_MB=100
# Under this many MB free the operator health page warns (0 = no early warning).
DISK_WARN_MB=1000
# Requests per minute per client address (0 = off). /health is never limited.
RATE_LIMIT_PER_MINUTE=240
# Lock a client out (429 on every endpoint) after this many wrong keys, tokens or
# enrollment codes within AUTH_FAILURE_WINDOW_SECONDS (0 = off). Cleared on restart.
AUTH_FAILURE_LIMIT=10
AUTH_FAILURE_WINDOW_SECONDS=600
# Reverse proxies whose X-Forwarded-For header is believed (app/client_address.py), so
# request limits and lock-outs apply to each real client instead of the proxy's address.
# Comma-separated addresses or ranges, e.g. 127.0.0.1 for nginx/Caddy on the same machine.
# Leave empty unless the coordinator really sits behind a proxy: then the header is ignored
# and nobody can choose their own address. Start uvicorn with --no-proxy-headers so this is
# the only setting that decides it. "Trust everyone" (0.0.0.0/0) is refused.
TRUSTED_PROXIES=
# Worker-side inference (optional; only needed for llm:generate jobs)
# LLAMA_CLI=/path/to/llama.cpp/build/bin/llama-cli
# MODEL_DIR=./models
# MODEL_REGISTRY=./models/registry.json
# How the worker starts llama-cli (app/llm_runner.py, rule llm-run-v1). llama-cli never sees
# this file's tokens or codes: it gets only PATH, HOME, locale/temp and GPU driver settings.
# One card per worker: the Vulkan device number this worker may use (0, 1, ...). Run one
# worker per card with a different number. Unset = llama.cpp picks (may share a card).
# LLM_VK_DEVICE=0
# Layers on the GPU (-ngl): 99 = all (default), 0 = CPU only.
# LLM_GPU_LAYERS=99
# CPU threads for llama-cli (-t), 1-64. Unset = llama.cpp's default.
# LLM_THREADS=
# Worker side: one-time code from the operator, used on the first run only.
# BNH_ENROLLMENT_CODE=
# Worker side: coordinator public key from the operator (python -m app.signing).
# Unset = pin whatever key the coordinator serves on first contact.
# BNH_COORDINATOR_KEY=
