DATABASE_PATH=./data/prototype.sqlite3
# Coordinator logs: json (one object per line) or text, and debug|info|warning|error.
# Logs never contain keys, tokens, codes, prompts or answers.
LOG_FORMAT=json
LOG_LEVEL=info
# Coordinator's Ed25519 private key for signing jobs. Created on first start (owner-only).
# Default: coordinator-signing.key next to the database. Never commit or share it.
# (PROTOTYPE_SECRET is no longer used.)
# COORDINATOR_SIGNING_KEY_FILE=./data/coordinator-signing.key
# Seconds a worker holds a job before it is requeued (5-3600)
LEASE_SECONDS=60
# Claims allowed per job before it is marked failed/rejected (1-20)
MAX_ATTEMPTS=3
# Share of unproven (schema-only) results re-run by another worker, 0.0-1.0
AUDIT_RATE=0.25
# When a re-run disagrees, send the job to a third worker to break the tie (true/false)
TIEBREAK=true
# Audits and tie-breakers go to a random active worker, not whoever asks first.
# A worker counts as active this many seconds after its last request (10-86400)
AUDITOR_ACTIVE_SECONDS=300
# Seconds the chosen worker has to pick up its audit before it is re-assigned (5-86400)
AUDIT_ASSIGN_SECONDS=120
# Unlocks operator endpoints (/v1/enrollments, /v1/challenges, /v1/audits,
# /v1/workers/{id}/trust, /v1/workers/{id}/revoke). Without it, make worker enrollment
# codes from the database instead: python -m app.workers enroll --owner <label>
# Leave unset to disable them. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value.
# OPERATOR_TOKEN=
# Worker-side inference (optional; only needed for llm:generate jobs)
# LLAMA_CLI=/path/to/llama.cpp/build/bin/llama-cli
# MODEL_DIR=./models
# MODEL_REGISTRY=./models/registry.json
# Worker side: one-time code from the operator, used on the first run only.
# BNH_ENROLLMENT_CODE=
# Worker side: coordinator public key from the operator (python -m app.signing).
# Unset = pin whatever key the coordinator serves on first contact.
# BNH_COORDINATOR_KEY=
